{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "SSC_BUILD_TESTS": "ON",
        "SSC_BUILD_PLUGIN": "ON"
      }
    },
    {
      "name": "dev",
      "displayName": "Debug (plugin + tests)",
      "inherits": "base",
      "generator": "Ninja",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "release",
      "displayName": "Release (plugin + tests)",
      "inherits": "base",
      "generator": "Ninja",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "core-tests",
      "displayName": "DSP core tests only (fast)",
      "inherits": "base",
      "generator": "Ninja",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "SSC_BUILD_PLUGIN": "OFF" }
    },
    {
      "name": "sanitize",
      "displayName": "DSP core tests with ASan/UBSan",
      "inherits": "base",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "SSC_BUILD_PLUGIN": "OFF",
        "SSC_ENABLE_SANITIZERS": "ON"
      }
    },
    {
      "name": "rtsan",
      "displayName": "Core and plugin tests with RealtimeSanitizer (Clang 20+: CC=clang-20 CXX=clang++-20)",
      "inherits": "base",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "SSC_ENABLE_RTSAN": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "dev", "configurePreset": "dev" },
    { "name": "release", "configurePreset": "release" },
    { "name": "core-tests", "configurePreset": "core-tests" },
    { "name": "sanitize", "configurePreset": "sanitize" },
    { "name": "rtsan", "configurePreset": "rtsan", "targets": [ "ssc_core_tests", "ssc_plugin_tests" ] }
  ],
  "testPresets": [
    { "name": "dev", "configurePreset": "dev", "output": { "outputOnFailure": true } },
    { "name": "release", "configurePreset": "release", "output": { "outputOnFailure": true } },
    { "name": "core-tests", "configurePreset": "core-tests", "output": { "outputOnFailure": true } },
    { "name": "sanitize", "configurePreset": "sanitize", "output": { "outputOnFailure": true } },
    { "name": "rtsan", "configurePreset": "rtsan", "output": { "outputOnFailure": true } }
  ]
}
